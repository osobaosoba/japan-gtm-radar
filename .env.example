# 動作モード: demo（架空のデモデータ・外部API呼び出しなし） / live（Nimble + Jev を実際に呼ぶ）
# demo と live は別の SQLite ファイルを使うため、データは混ざりません。
APP_MODE=demo

# ライブモードで必須。サーバー側でのみ読み込みます（画面・ログには出しません）。
NIMBLE_API_KEY=
TYPESAFE_API_KEY=

# 任意: Jev のモデル（既定 jev-latest）
TYPESAFE_DEFAULT_MODEL=jev-latest

# 任意: DBファイルの上書き（既定 data/live.db / data/demo.db）
# LIVE_DATABASE_URL=file:../data/live.db
# DEMO_DATABASE_URL=file:../data/demo.db
# Clay Public API (Decode Japan people search). Server-side only.
CLAY_PUBLIC_API_KEY=
