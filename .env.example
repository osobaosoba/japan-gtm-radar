# Mode: demo (recorded/fictional data, no external API calls) / live (calls Nimble, Jev and Clay)
# Demo and live use separate files (data/demo.json, data/live.json), so data never mixes.
APP_MODE=demo

# Required in live mode. Read on the server only (never shown in the UI or logs).
NIMBLE_API_KEY=
TYPESAFE_API_KEY=

# Optional: Jev model (default jev-latest)
TYPESAFE_DEFAULT_MODEL=jev-latest

# Clay Public API (Decode Japan people search). Server-side only.
CLAY_PUBLIC_API_KEY=
