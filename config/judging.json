{
  "_comment": "判定ルールと閾値。npm run calibrate で検証データ(data/validation/labeled.json)に対する精度を見て調整する。questionSetVersion を変えると同じ証拠でも再判定される。",
  "questionSetVersion": "gtm-q-2026.10.2",
  "thresholds": {
    "targetCompanyMin": 0.7,
    "targetCompanyReviewBand": 0.2,
    "japanRelevantMin": 0.5,
    "signalPresentMin": 0.55,
    "signalReviewBand": 0.15,
    "statusConfidenceMin": 0.35,
    "stageConfidenceMin": 0.35,
    "motionMin": 0.6,
    "jobJapanRoleMin": 0.5,
    "dedicatedTeamMin": 0.6,
    "duplicateSimilarity": 0.85,
    "staleDays": 365,
    "meaningfulDiffMinChars": 40
