  "limits": {
    "nimbleCallsPerRun": 80,
    "nimbleCallsPerDay": 400,
    "jevCallsPerRun": 400,
    "jevCallsPerDay": 2000,
    "concurrency": 5,
    "minIntervalMs": 300,
    "nimbleTimeoutMs": 90000,
    "jevTimeoutMs": 30000,
    "maxRetries": 2,
    "maxStateChars": 9000,
    "maxJobsJudgedPerSource": 12
  },
  "discovery": {
    "maxResultsPerQuery": 6,
    "country": "JP",
    "locale": "ja",
    "searchDepth": "lite",
    "queryTemplates": [
      "{name} 日本 AI",
      "{name} 日本 提携 OR 導入 OR 東京"
    ]
  },
  "monitoring": {
    "_comment": "情報源の種類ごとの監視間隔（時間）。変わっていない情報源はJevに回さないので、間隔を短くしても増えるのは主にNimbleの取得だけ",
    "defaultIntervalHours": 168,
    "intervalHoursByKind": { "corporate_registry": 24, "careers_ats": 24 }
  }
}